{
  "name": "pollinations-figma",
  "version": "1.0.0",
  "description": "Generate and edit images with Pollinations inside Figma, paying with your own Pollen (BYOP).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guest453/pollinations-figma"
  },
  "type": "module",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=dist/code.js --format=iife --platform=browser && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.125.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
